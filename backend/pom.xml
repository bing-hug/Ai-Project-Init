<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.aiproject.init</groupId>
    <artifactId>aiproject-init-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>aiproject-init-backend</name>
    <description>多模块后端父工程：contract 存契约，service 存实现</description>

    <modules>
        <module>contract</module>
        <module>service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!--
      只声明跨模块共享的版本。后续接入 MyBatis-Plus / JWT / springdoc 时，
      统一加在这里，子模块一律不写 <version>。
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.aiproject.init</groupId>
                <artifactId>aiproject-init-contract</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
